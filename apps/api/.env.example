# Copy to apps/api/.env.
ENVIRONMENT=local
# JSON list of origins allowed to call the API from a browser.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Used from the database stage onwards. Matches the root .env.example defaults.
DATABASE_URL=postgresql+asyncpg://voicelog:voicelog_local@127.0.0.1:5432/voicelog
OPENAI_API_KEY=
