# Copy to apps/api/.env.
ENVIRONMENT=local
# JSON list of origins allowed to call the API from a browser.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Must match POSTGRES_* in the root .env, which configures the local database container.
DATABASE_URL=postgresql+asyncpg://voicelog:voicelog_local@127.0.0.1:5432/voicelog

# Leave empty to save notes without AI summary, category, tags, action items, or
# embeddings; audio upload and search then return 503. With a key, each new note makes
# one chat and one embedding request, plus one transcription request for audio.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Must produce 1536 dimensions to match the notes.embedding column.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
