// Note enrichment: transcript -> category, action items, summary.
{"id": "spec-example", "critical": true, "transcript": "Had a sync with Sarah about the release. Need to fix the login bug by Friday.", "expect": {"category": "Work", "action_items": ["login bug"], "max_action_items": 1, "summary_script": "latin", "summary_includes": ["sarah"]}}
{"id": "no-tasks-run", "critical": true, "note": "must not invent tasks", "transcript": "Went for a long run along the river this morning, felt great. Legs are sore now.", "expect": {"category": "Personal", "max_action_items": 0}}
{"id": "idea-no-tasks", "transcript": "What if we built a browser extension that turns any recipe page into a shopping list?", "expect": {"category": "Ideas", "max_action_items": 0}}
{"id": "two-tasks", "transcript": "Grocery run later: need milk, eggs, and coffee. Also have to call the landlord about the leaking sink.", "expect": {"category": "Personal", "action_items": [["milk", "grocer", "eggs", "coffee", "shopping"], "landlord"], "max_action_items": 4}}
{"id": "others-task", "note": "Priya's task is not the speaker's", "transcript": "Quarterly planning: I own the hiring plan, due next Wednesday, and Priya will draft the budget.", "expect": {"category": "Work", "action_items": ["hiring plan"], "max_action_items": 1}}
